# High: improvement. Low: mutation, repair, reflection.
# Explicit provider/model IDs and independent credentials; no shared fallbacks.
# API_BASE may be blank for the provider default.
# MAX_TOKENS is a client default; RunConfig stage caps take precedence.
LLM_HIGH_MODEL=''
LLM_HIGH_API_KEY='<YOUR-API-KEY>'
LLM_HIGH_API_BASE=''
LLM_HIGH_REASONING_EFFORT='high'
LLM_HIGH_TIMEOUT='180'
LLM_HIGH_MAX_RETRIES='2'
LLM_HIGH_MAX_TOKENS='1024'
LLM_LOW_MODEL=''
LLM_LOW_API_KEY='<YOUR-API-KEY>'
LLM_LOW_API_BASE=''
LLM_LOW_REASONING_EFFORT='low'
LLM_LOW_TIMEOUT='60'
LLM_LOW_MAX_RETRIES='2'
LLM_LOW_MAX_TOKENS='1024'
