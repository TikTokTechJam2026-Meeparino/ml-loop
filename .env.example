# Use a LiteLLM provider/model identifier from your provider's model catalog.
# Examples of prefixes: anthropic/, gemini/, openrouter/, openai/, ollama_chat/
LLM_MODEL=<PROVIDER/MODEL>
LLM_API_KEY=<YOUR-API-KEY>
# Optional custom endpoint. Leave blank for the provider default.
LLM_API_BASE=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024
